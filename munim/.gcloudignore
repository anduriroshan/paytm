# What `gcloud run deploy --source .` uploads to Cloud Build. Keep secrets and bulky local folders out.
.gcloudignore
.git/
.gitignore
**/.env
**/.env.*
!**/.env.example
backend/.venv/
backend/data/
**/__pycache__/
**/.pytest_cache/
**/*.db
**/*.db-*
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
docs/
design/
*.log
