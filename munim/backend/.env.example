# Copy to backend/.env and fill what you have. Anything left blank runs on the offline mock, so the demo always works.

# ── Provider keys ─────────────────────────────────────────────
# Gemini: create a key at https://aistudio.google.com/apikey (link the project to your Cloud billing account to use credits)
GEMINI_API_KEY=
# Sarvam: https://dashboard.sarvam.ai  (chat, Prism decisions, speech share one credit balance)
SARVAM_API_KEY=
# Any other OpenAI-compatible server (Ollama, vLLM, OpenRouter, ...). Use provider "openai" in the routing below.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# ── Role routing: provider:model  (provider = gemini | sarvam | openai | mock) ──
# Reasoner: structured JSON work (intake, propose action, improvise SQL probes)
MUNIM_REASONER=gemini:gemini-flash-latest
# Writer: merchant-facing replies in Hindi / Telugu / Hinglish / English
MUNIM_WRITER=sarvam:sarvam-105b
# Decider: the detective's hunch, probabilities over suspects + injection score (sarvam:sarvam-prism | llm | mock)
MUNIM_DECIDER=sarvam:sarvam-prism
# Voice (stretch): sarvam | off
MUNIM_VOICE=sarvam
MUNIM_REASONING_EFFORT=low
# Writer replies need no thinking; sarvam-105b otherwise reasons at 'medium' and can run out of tokens
MUNIM_WRITER_REASONING_EFFORT=none

# 1 = ignore keys and run the scripted offline demo (venue Wi-Fi died? flip this)
MUNIM_FORCE_MOCK=0

# ── Action Firewall policy ────────────────────────────────────
MUNIM_AUTO_LIMIT_PAISE=200000
MUNIM_MERCHANT_30D_LIMIT_PAISE=500000
MUNIM_INJECTION_THRESHOLD=0.8
